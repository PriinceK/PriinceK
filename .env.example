# Amazon UK Price Scout — API Keys
# Copy this file to .env and fill in your keys

# Rainforest API (required) — amazon.co.uk product data, BSR, seller info
# Get a key at https://www.rainforestapi.com/
VITE_RAINFOREST_API_KEY=

# SerpAPI (optional) — Google Shopping web price comparison
# Get a key at https://serpapi.com/
VITE_SERPAPI_KEY=
